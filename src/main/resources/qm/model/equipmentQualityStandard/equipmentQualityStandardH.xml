<?xml version="1.0" encoding="UTF-8"?>
<model name="equipmentQualityStandardH" activable="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/model" xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">
    <fields>
        <belongsTo name="tool" plugin="cmmsMachineParts" model="tool" required="true" />

        <hasMany name="equipmentQualityStandardLs" model="equipmentQualityStandardL" joinField="equipmentQualityStandardH" />
        <hasMany name="attachments" model="eQSHAttachment" joinField="equipmentQualityStandardH" cascade="delete"/>
        <enum name="inspectionType" values="01equipment,02internalCalibration,03externalCalibration" required="true"/>
        <enum name="statusText" values="01noStandard,02hasStandard" persistent="false"/>
    </fields>

    <identifier expression="#tool['number'] + ' - ' + #tool['name'] + ' - ' + #inspectionType" />
    <hooks>
        <!-- <onSave class="com.fti.qm.hooks.standard.inProcess.InProcessQualityStandardHHooks" method="onSave" /> -->
    </hooks>
</model>