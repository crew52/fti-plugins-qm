<?xml version="1.0" encoding="UTF-8"?>
<model name="measuringEquipment"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/model" xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">
    <fields>
        <string name="number" required="true" unique="true">
            <validatesLength max="255" />
        </string>
        <string name="name" required="true">
            <validatesLength max="255" />
        </string>
        <string name="measuringMethod" required="true">
            <validatesLength max="255" />
        </string>
    </fields>
    <hooks>
        <onCreate class="com.fti.qm.hooks.MeasuringEquipmentHooks" method="onCreate" />
    </hooks>
    <identifier expression="#number + ' - ' + #name" />
</model>