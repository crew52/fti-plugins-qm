<?xml version="1.0" encoding="UTF-8"?>
<model name="inProcessQualityStandardH" activable="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/model" xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">
    <fields>
        <belongsTo name="product" plugin="basic" model="product" required="true" />

        <hasMany name="inProcessQualityStandardLs" model="inProcessQualityStandardL" joinField="inProcessQualityStandardH" />
        <hasMany name="attachments" model="iPQSHAttachment" joinField="inProcessQualityStandardH" cascade="delete"/>

        <enum name="statusText" values="01noStandard,02hasStandard" persistent="false"/>
    </fields>

    <identifier expression="#product['number'] + ' - ' + #product['name']" />
    <hooks>
        <onSave class="com.fti.qm.hooks.standard.inProcess.InProcessQualityStandardHHooks" method="validateUniqueActiveProduct" />
    </hooks>
</model>