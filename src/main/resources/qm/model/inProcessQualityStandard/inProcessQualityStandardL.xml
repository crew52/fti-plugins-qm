<?xml version="1.0" encoding="UTF-8"?>
<model name="inProcessQualityStandardL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/model" xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">
    <fields>
        <string name="position">
            <validatesLength max="255" />
        </string>

        <string name="description">
            <validatesLength max="255" />
        </string>

        <enum name="qualitativeValue" values="01pass"/>
        <boolean name="qualitativeCheckbox" persistent="false"/>

        <decimal name="quantitativeValue" />
        <decimal name="tolerance" />
        <decimal name="upValue" />
        <decimal name="downValue" />

        <integer name="sampleSize" required="true" />

        <dictionary name="unit" dictionary="units"/>

        <belongsTo name="qualityCriteria" model="qualityCriteria" required="true" />

        <belongsTo name="measuringEquipment" model="measuringEquipment" required="true" />

        <belongsTo name="inProcessQualityStandardH" model="inProcessQualityStandardH" required="true" />

    </fields>

    <identifier expression="#qualityCriteria['number'] + ' - ' + #qualityCriteria['name']" />

    <hooks>
        <onSave class="com.fti.qm.hooks.inProcessQualityStandard.InProcessQualityStandardLHooks" method="onSave" />
        <onView class="com.fti.qm.hooks.inProcessQualityStandard.InProcessQualityStandardLHooks" method="onView" />
    </hooks>

</model>