<?xml version="1.0" encoding="UTF-8"?>
<model name="incomingQualityStandardL"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/model" xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">
    <fields>
        <string name="position">
            <validatesLength max="255" />
        </string>

        <string name="description">
            <validatesLength max="255" />
        </string>

        <enum name="qualitativeValue" values="01qualitative" />

        <decimal name="quantitativeValue" precision="10" scale="2" />
        <decimal name="tolerance" precision="10" scale="2" />
        <decimal name="upValue" precision="10" scale="2" />
        <decimal name="downValue" precision="10" scale="2" />

        <integer name="sampleSize" required="true" />

        <dictionary name="unit" dictionary="units"/>

        <belongsTo name="qualityCriteria" model="qualityCriteria" required="true" />

        <belongsTo name="measuringEquipment" model="measuringEquipment" required="true" />

        <belongsTo name="incomingQualityStandardH" model="incomingQualityStandardH" required="true" />

    </fields>

    <identifier expression="(#position != null ? #position + ' - ' : '') + (#description != null ? #description + ' | ' : '') + #qualityCriteria['number'] + ' - ' + #qualityCriteria['name'] + ' | ' + #measuringEquipment['number'] + ' - ' + #measuringEquipment['name'] + ' | ' + 'Size: ' + #sampleSize" />

    <hooks>
        <onSave class="com.fti.qm.hooks.IncomingQualityStandardLHooks" method="onSave" />
    </hooks>

</model>