<?xml version="1.0" encoding="UTF-8"?>
<model name="qualityCriteria" auditable="true"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/model" xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">
    <fields>
        <string name="number" required="true" unique="true">
            <validatesLength max="255" />
        </string>
        <string name="name" required="true">
            <validatesLength max="255" />
        </string>
        <enum name="type" values="01qualitative,02quantitative" />
        <dictionary name="unit" dictionary="units"/>

        <hasMany name="qualityStandardLs" model="qualityStandardL" joinField="qualityCriteria" cascade="delete"/>

        <boolean name="deleted" default="false" />
        <datetime name="deletedDate" />
    </fields>
    <hooks>
        <onCreate class="com.fti.qm.hooks.common.SetDefaultDeletedHook" method="onCreate" />
        <onUpdate class="com.fti.qm.hooks.QualityCriteriaHooks" method="onUpdate" />
    </hooks>
    <identifier expression="#number + ' - ' + #name" />
</model>