<?xml version="1.0" encoding="UTF-8"?>
<model name="qualityCriteria"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/model" xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">
    <fields>
        <string name="number" required="true" unique="true">
            <validatesLength max="255" />
        </string>
        <string name="name" required="true">
            <validatesLength max="255" />
        </string>
        <enum name="type" values="01qualitative,02quantitative" />
        <dictionary name="unit" dictionary="units"/>

        <hasMany name="incomingQualityStandardLs" model="incomingQualityStandardL" joinField="measuringEquipment" cascade="delete"/>
        <hasMany name="outgoingQualityStandardLs" model="outgoingQualityStandardL" joinField="measuringEquipment" cascade="delete"/>
        <hasMany name="inProcessQualityStandardLs" model="inProcessQualityStandardL" joinField="measuringEquipment" cascade="delete"/>
        <hasMany name="equipmentQualityStandardLs" model="equipmentQualityStandardL" joinField="measuringEquipment" cascade="delete"/>
    </fields>
    <hooks />
    <identifier expression="#number + ' - ' + #name" />
</model>