<?xml version="1.0" encoding="UTF-8"?>
<model name="qualityInspectionCommandListDto"
       activable="false" auditable="false" deletable="false" insertable="false"
       updatable="false"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns="http://schema.qcadoo.org/model"
       xsi:schemaLocation="http://schema.qcadoo.org/model http://schema.qcadoo.org/model.xsd">

    <fields>
        <enum name="inspectionType" values="01incoming,02inprocess,03outgoing,04equipment"/>
        <date name="fromDate"/>
        <date name="toDate"/>
        <enum name="status" values="01new,02inProgress,03completed"/>
        <string name="productionOrderNumber"/>
        <string name="operationNumber"/>
        <integer name="company_id"/>
        <string name="companyNumber"/>
        <string name="companyName"/>
        <integer name="product_id"/>
        <string name="productNumber"/>
        <string name="productName"/>
        <integer name="tool_id"/>
        <string name="toolNumber"/>
        <string name="toolName"/>
        <string name="inspectionOrderNumber"/>
        <string name="poNumber"/>
        <date name="executionDate"/>
        <decimal name="transactionQuantity"/>
        <string name="warehouse"/>
        
        <belongsTo name="qualityInspectionCommandContext" plugin="qm" model="qualityInspectionCommandContext"/>
    </fields>

    <!-- Identifier -->
    <identifier expression="#inspectionOrderNumber"/>
    <masterModel plugin="qm" model="qualityInspectionCommand"/>
</model>
