<view xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns="http://schema.qcadoo.org/view" xsi:schemaLocation="http://schema.qcadoo.org/view http://schema.qcadoo.org/view.xsd" name="qualityInspectionCommandList" modelName="qualityInspectionCommandContext" modelPlugin="qm" menuAccessible="true">

    <component type="window" name="window" reference="window">

        <ribbon>
            <group name="contextActions">
                <bigButton name="confirmContext" icon="startIcon24.png" state="enabled">
                    <script>
                        <![CDATA[
							this.addOnChangeListener({
								onClick: function() {
									#{form}.performEvent('confirmContext', ['qualityInspectionCommand']);
								}
							});
						]]>
                    </script>
                </bigButton>
            </group>
        </ribbon>

        <windowTab name="contextTab" reference="contextTab">
            <component type="form" name="eventContextForm" reference="form">
                <script>
                    <![CDATA[
						this.addOnChangeListener({
							onSetValue: function(value) {
								if (! value || ! value.content) {
									return;
								}
								updateRibbon();
							}
						});

						function updateRibbon() {
							var confirmed = #{confirmed}.getValue().content.value,
							    confirmContextButton = #{window}.getRibbonItem("contextActions.confirmContext"),
							    confirmContextButtonLabel;

							if (confirmed == 'true' || confirmed == '1') {
								confirmContextButtonLabel = "#{translate(qm.qualityInspectionCommandList.window.ribbon.contextActions.changeContext)}";
							} else {

							    confirmContextButtonLabel = "#{translate(qm.qualityInspectionCommandList.window.ribbon.contextActions.confirmContext)}";
							}

							confirmContextButton.setLabel(confirmContextButtonLabel);
						}
					]]>
                </script>
                <component type="gridLayout" name="gridLayout" columns="4" rows="6" hasBorders="false">
                    <!-- Loại kiểm tra -->
                    <layoutElement column="1" row="1">
                        <component type="select" name="inspectionType" field="inspectionType" reference="inspectionType"/>
                    </layoutElement>

                    <!-- Từ ngày -->
                    <layoutElement column="1" row="2">
                        <component type="calendar" name="fromDate" field="fromDate" reference="fromDate"/>
                    </layoutElement>

                    <!-- Đến ngày -->
                    <layoutElement column="1" row="3">
                        <component type="calendar" name="toDate" field="toDate" reference="toDate"/>
                    </layoutElement>

                    <!-- Trạng thái -->
                    <layoutElement column="1" row="4">
                        <component type="select" name="status" field="status" reference="status"/>
                    </layoutElement>

                    <!-- Mã lệnh sản xuất -->
                    <layoutElement column="1" row="5">
                        <component type="input" name="productionOrderNumber" field="productionOrderNumber" reference="productionOrderNumber" />
                    </layoutElement>

                    <!-- Mã công đoạn -->
                    <layoutElement column="1" row="6">
                        <component type="input" name="operationNumber" field="operationNumber" reference="operationNumber"/>
                    </layoutElement>

                    <!-- Mã nhà cung cấp -->
                    <layoutElement column="2" row="1">
                        <component type="lookup" name="company" field="company" reference="company" hasDescription="true">
                            <option type="column" name="name" fields="name"/>
                            <option type="expression" value="#number + ' - ' + #name"/>
                            <option type="fieldCode" value="number" />
                        </component>
                    </layoutElement>

                    <!-- Tên nhà cung cấp -->
                    <layoutElement column="2" row="2">
                        <component type="input" name="companyName" field="companyName" reference="companyName"/>
                    </layoutElement>

                    <!-- Mã sản phẩm -->
                    <layoutElement column="2" row="3">
                        <component type="lookup" name="product" field="product" reference="product" hasDescription="true">
                            <option type="column" name="name" fields="name"/>
                            <option type="expression" value="#number + ' - ' + #name"/>
                            <option type="fieldCode" value="number" />
                        </component>
                    </layoutElement>

                    <!-- Tên sản phẩm -->
                    <layoutElement column="2" row="4">
                        <component type="input" name="productName" field="productName" reference="productName"/>
                    </layoutElement>

                    <!-- Mã thiết bị -->
                    <layoutElement column="2" row="5">
                        <component type="lookup" name="tool" field="tool" reference="tool" hasDescription="true">
                            <option type="column" name="name" fields="name"/>
                            <option type="expression" value="#number + ' - ' + #name"/>
                            <option type="fieldCode" value="number" />
                        </component>
                    </layoutElement>

                    <!-- Tên sản phẩm -->
                    <layoutElement column="2" row="6">
                        <component type="input" name="toolName" field="toolName" reference="toolName"/>
                    </layoutElement>

                    <layoutElement column="3" row="1">
                        <component type="hidden" name="confirmed" field="confirmed"
                                   reference="confirmed"/>
                    </layoutElement>
                </component>
                <listener event="confirmContext" method="confirmContext" class="com.fti.qm.listeners.QualityInspectionCommandListListeners"/>
            </component>
        </windowTab>

        <windowTab name="mainTab" reference="mainTab">
            <component type="grid" name="qualityInspectionCommandListDtos" reference="grid" field="#{form}.qualityInspectionCommandListDtos">
                <!-- SCRIP -->
                <option type="column" name="inspectionOrderNumber" fields="inspectionOrderNumber"/>
                <option type="column" name="status" fields="status"/>
                <option type="column" name="poNumber" fields="poNumber"/>
                <option type="column" name="executionDate" fields="executionDate"/>
                <option type="column" name="productNumber" fields="productNumber"/>
                <option type="column" name="productName" fields="productName"/>
                <option type="column" name="companyNumber" fields="companyNumber"/>
                <option type="column" name="companyName" fields="companyName"/>
                <option type="column" name="productionOrderNumber" fields="productionOrderNumber"/>
                <option type="column" name="transactionQuantity" fields="transactionQuantity"/>
                <option type="column" name="warehouse" fields="warehouse"/>

                <option type="searchable" value="inspectionOrderNumber,status,poNumber,productNumber,productName,companyNumber,companyName,productionOrderNumber,transactionQuantity,warehouse,executionDate"/>
                <option type="orderable" value="inspectionOrderNumber,status,poNumber,productNumber,productName,companyNumber,companyName,productionOrderNumber,transactionQuantity,warehouse,executionDate"/>
                <option type="multiselect" value="true"/>
                <option type="fullscreen" value="true"/>

                <option type="order" column="number" direction="desc"/>
                <option type="fullscreen" value="true"/>

                <!-- <listener event="changeState" class="com.qcadoo.mes.cmmsMachineParts.states.PlannedEventStateChangeViewClient" method="changeState"/>

                <listener event="onSelectedEntityChange" class="com.qcadoo.mes.cmmsMachineParts.listeners.EventsListListeners" method="onSelectedEventChange"/>

                <listener event="showMaintenanceEvent" method="showMaintenanceEvent" class="com.qcadoo.mes.cmmsMachineParts.listeners.EventsListListeners"/> -->

                <!-- <criteriaModifier class="com.qcadoo.mes.cmmsMachineParts.criteriaModifiers.EventCriteriaModifiersCMP" method="showPlannedEventsFromContext"/> -->
            </component>
        </windowTab>

        <option type="fixedHeight" value="true"/>
        <option type="header" value="false"/>

        <!-- <listener event="addPlannedEvent" method="addPlannedEvent" class="com.qcadoo.mes.cmmsMachineParts.listeners.EventsListListeners"/>

        <listener event="printXlsReport" method="printXlsReport" class="com.qcadoo.mes.cmmsMachineParts.listeners.EventsListListeners"/>

        <listener event="showWorkTime" method="showWorkTime" class="com.qcadoo.mes.cmmsMachineParts.listeners.WorkTimeForUserListeners"/> -->

    </component>

    <hooks>
        <!-- <beforeRender class="com.qcadoo.mes.cmmsMachineParts.hooks.EventHooks" method="onBeforeRenderPlannedListView"/>
        <beforeRender class="com.qcadoo.mes.cmmsMachineParts.hooks.PlannedEventDetailsHooks" method="processRoles"/> -->
    </hooks>
</view>
