        <windowTab name="qualityDecisionTab" reference="qualityDecisionTab">
            <component type="gridLayout" name="qualityDecisionGridLayout" columns="4" rows="4">
                <layoutElement column="1" row="1">
                    <component type="select" name="qualityDecision" field="#{form}.qualityDecision" reference="qualityDecision"/>
                </layoutElement>
                <layoutElement column="1" row="2">
                    <component type="checkbox" name="qualityDecisionCheckBox" reference="qualityDecisionCheckBox">
                        <listener event="onChange" class="com.fti.qm.listeners.QICDetailsListeners" method="onQualityDecisionCheckBoxChange" />
                    </component>
                </layoutElement>
                <layoutElement column="2" row="1">
                    <component type="input" name="warehouseQuantity" field="#{form}.warehouseQuantity" reference="warehouseQuantity" defaultEnabled="false">
                        <listener event="onInputChange" class="com.fti.qm.listeners.QICDetailsListeners" method="onWarehouseQtyChange" />
                    </component>
                </layoutElement>
                <layoutElement column="2" row="2">
                    <component type="input" name="ngQuantity" field="#{form}.ngQuantity" reference="ngQuantity" defaultEnabled="false">
                        <listener event="onInputChange" class="com.fti.qm.listeners.QICDetailsListeners" method="onNgQtyChange" />
                    </component>
                </layoutElement>
                <layoutElement column="2" row="3">
                    <component type="lookup" name="warehouseLocation" field="#{form}.warehouseLocation" reference="warehouseLocation" hasDescription="true" defaultEnabled="false">
                        <option type="column" name="name" fields="name"/>
                        <option type="expression" value="#number + ' - ' + #name"/>
                        <option type="searchable" value="name"/>
                        <option type="orderable" value="name"/>
                        <option type="fieldCode" value="number"/>
                        <criteriaModifier class="com.fti.qm.criteriaModifiers.QICCriteriaModifiers" method="warehouseLocationModifier"/>
                    </component>
                </layoutElement>
                <layoutElement column="2" row="4">
                    <component type="lookup" name="ngLocation" field="#{form}.ngLocation" reference="ngLocation" hasDescription="true" defaultEnabled="false">
                        <option type="column" name="name" fields="name"/>
                        <option type="expression" value="#number + ' - ' + #name"/>
                        <option type="searchable" value="name"/>
                        <option type="orderable" value="name"/>
                        <option type="fieldCode" value="number"/>
                        <criteriaModifier class="com.fti.qm.criteriaModifiers.QICCriteriaModifiers" method="ngLocationModifier"/>
                    </component>
                </layoutElement>
            </component>
            <option type="header" value="true"/>
        </windowTab>

        <windowTab name="attachments">
            <component type="gridLayout" name="attachmentsLayout" columns="3" rows="6" hasBorders="false">

                <!-- Cột trái: Giao diện upload -->
                <layoutElement column="1" row="1" height="6">
                    <component type="staticPage" name="multiUpload">
                        <option type="page" value="qm/multiUploadForQIC.jsp"/>
                    </component>

                    <!-- Trường ẩn: ID thực thể -->
                    <component type="input" name="qicIdForMultiUpload" reference="qicIdForMultiUpload" defaultVisible="false">
                        <option type="alignment" value="right"/>
                    </component>

                    <!-- Trường ẩn: Locale -->
                    <component type="input" name="qicMultiUploadLocale" reference="qicMultiUploadLocale" defaultVisible="false" />
                </layoutElement>

                <!-- Cột phải: Grid danh sách file đã đính kèm -->
                <layoutElement column="2" row="1" width="2" height="6">
                    <component type="grid" name="attachments" reference="attachmentsGrid" source="#{form}.attachments">
                        <option type="column" name="attachment" fields="name" correspondingField="attachmentLocation" link="true" attachment="true"/>
                        <option type="column" name="attachmentLocation" fields="attachment" hidden="true"/>
                        <option type="column" name="size" fields="size"/>
                        <option type="order" column="attachment" direction="desc"/>

                        <option type="softDeletable" value="true"/>
                        <option type="fullscreen" value="true"/>
                        <option type="multiselect" value="true"/>
                    </component>
                </layoutElement>

            </component>
        </windowTab>
    </component>

    <hooks>
        <beforeRender class="com.fti.qm.hooks.QICDetailsHooksRe" method="beforeRender"/>
        <beforeRender class="com.fti.qm.hooks.standard.QICDetailsHooks" method="setQICIdForMultiUploadField"/>
    </hooks>
</view>